DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kabul
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Set these variables to use PostgreSQL. Without POSTGRES_DB, SQLite is used.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PG_DUMP_PATH=pg_dump

# Daily database backup location and retention. Set retention to 0 to keep all.
DATABASE_BACKUP_DIR=backups
DATABASE_BACKUP_RETENTION_DAYS=30

# Production-only transport security; HTTPS redirect defaults to true when debug is false.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
